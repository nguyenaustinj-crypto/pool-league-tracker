# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored -- never commit real credentials.
#
# Keep everything local in `.env`, not `.env.local`: the app reads both, but
# Prisma CLI commands (migrate, seed) only read `.env`, and the two must
# point at the same database.

# The DEVELOPMENT database's Postgres connection string (starts with
# postgres://), used by the app and by Prisma CLI commands. Copy it from
# Vercel -> Storage -> pool-league-dev. Never put the production database's
# URL here: production's lives only in Vercel's environment variables.
# On a fresh dev database, run `npx prisma migrate deploy` and then
# `npx prisma db seed` to get tables and a test league.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Optional. A direct (non-pooled) connection used only by Prisma CLI
# commands like `migrate` and `studio`. If unset, they fall back to
# DATABASE_URL, which is fine for the current setup.
# DIRECT_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Shared editor passcode. Anyone can VIEW the site; entering this on the
# /login page lets that device add and change data for 30 days. There are no
# user accounts. Use a long passphrase (8+ characters required). If it's
# missing or too short, the site stays read-only for everyone. Changing it
# signs every device out. In production, set it in Vercel -> Settings ->
# Environment Variables, then redeploy. Locally, any 8+ characters will do.
EDITOR_PASSCODE=""
