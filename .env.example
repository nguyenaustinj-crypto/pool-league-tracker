# Copy this file to `.env` and fill in the real value.
# `.env` is gitignored -- never commit real credentials.

# Postgres connection string, used by the app at runtime (via the pg driver
# adapter in src/lib/prisma.ts) and by Prisma CLI commands.
# Get it from the Vercel project: Settings -> Environment Variables.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Optional. A direct (non-pooled) connection used only by Prisma CLI
# commands like `migrate` and `studio`. If unset, they fall back to
# DATABASE_URL, which is fine for the current setup.
# DIRECT_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Shared editor passcode. Anyone can VIEW the site; entering this on the
# /login page lets that device add and change data for 30 days. There are no
# user accounts. Use a long passphrase (8+ characters required). If it's
# missing or too short, the site stays read-only for everyone. Changing it
# signs every device out. In production, set it in Vercel -> Settings ->
# Environment Variables, then redeploy.
EDITOR_PASSCODE=""

# NOTE: local dev and the deployed app currently share ONE database. Anything
# you create while developing shows up on the live site, so clean up test
# data after yourself. See CLAUDE.md for the details.
