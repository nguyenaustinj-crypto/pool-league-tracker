// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model League {
  id             String             @id @default(cuid())
  name           String
  // The league's reusable player invite link is /invite/<inviteToken>.
  // Anyone with it can join as a player; a manager can reset it, which
  // makes the old link stop working. Null until one is created.
  inviteToken    String?            @unique
  teams          Team[]
  matches        Match[]
  memberships    LeagueMembership[]
  joinRequests   JoinRequest[]
  managerInvites ManagerInvite[]
}

// A persistent, named team within a league. Every Player belongs to exactly
// one Team (see Player below) -- a match's two sides are two of a league's
// Teams, and only players on that Team can be picked for that side.
model Team {
  id          String   @id @default(cuid())
  name        String
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId    String
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
}

model Player {
  id     String @id @default(cuid())
  name   String
  rating Float
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  homePairings Pairing[] @relation("HomePlayer")
  awayPairings Pairing[] @relation("AwayPlayer")
}

// A single match sheet: a "home" Team and an "away" Team, each fielding one
// player per table for this match (players must belong to the matching
// side's Team -- validated in createMatch/updateMatch).
model Match {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId   String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  homeTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  awayTeamId String
  rounds     Round[]
}

model Round {
  id          String    @id @default(cuid())
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  roundNumber Int
  pairings    Pairing[]
}

// One home player vs. one away player within a round, playing two games (racks).
// homePlayer/awayPlayer cascade so deleting a League (which cascades to its
// Teams, which cascade to their Players) doesn't hit a foreign key violation
// from Pairings still referencing them. The app-level guard against deleting
// an individual player who's in an active match (see deletePlayer in
// actions.ts) is what actually protects that case -- this cascade only
// matters once everything upstream (the whole League) is already being torn
// down.
model Pairing {
  id           String @id @default(cuid())
  round        Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId      String
  homePlayer   Player @relation("HomePlayer", fields: [homePlayerId], references: [id], onDelete: Cascade)
  homePlayerId String
  awayPlayer   Player @relation("AwayPlayer", fields: [awayPlayerId], references: [id], onDelete: Cascade)
  awayPlayerId String
  homeGame1    Float  @default(0)
  homeGame2    Float  @default(0)
  awayGame1    Float  @default(0)
  awayGame2    Float  @default(0)
}

// ---------------------------------------------------------------------------
// League membership. Leagues are members-only: only a league's members (and
// site admins) can see its pages. Managers run the league; players can view
// it. See src/lib/access.ts and docs/spec-accounts.md.
// ---------------------------------------------------------------------------

enum LeagueRole {
  MANAGER
  PLAYER
}

model LeagueMembership {
  league    League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      LeagueRole
  createdAt DateTime   @default(now())

  @@id([leagueId, userId])
  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// Someone asking a league's managers for something: to join as a player
// (found through search), or, for a player already in the league, to become
// a manager (role = MANAGER). One row per person per league: a new request
// reopens the same row.
model JoinRequest {
  id        String            @id @default(cuid())
  league    League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId  String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      LeagueRole        @default(PLAYER)
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  @@unique([leagueId, userId])
}

// A one-time invite to become one of a league's managers, created by a
// manager. Only a hash of the token is stored; the link is shown once, when
// it's created. Works for one person, once, until expiresAt.
model ManagerInvite {
  id          String    @id @default(cuid())
  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId    String
  tokenHash   String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?

  @@index([leagueId])
}

// ---------------------------------------------------------------------------
// Sign-in (Better Auth). These four models are Better Auth's own schema,
// generated with its CLI (`npx auth@1.7.5 generate --adapter prisma
// --dialect postgresql`); keep them in sync with that output when upgrading
// better-auth. The only additions are User's two relation lists for league
// membership, which Better Auth ignores. Google is the only sign-in method,
// so Account.password stays empty. Who's a site admin comes from the
// ADMIN_EMAILS env var, not the database.
// ---------------------------------------------------------------------------

model User {
  id            String             @id
  name          String
  email         String
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   LeagueMembership[]
  joinRequests  JoinRequest[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
