// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model League {
  id      String   @id @default(cuid())
  name    String
  players Player[]
  matches Match[]
}

model Player {
  id       String @id @default(cuid())
  name     String
  rating   Float
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String

  homePairings Pairing[] @relation("HomePlayer")
  awayPairings Pairing[] @relation("AwayPlayer")
}

// A single match sheet: a "home" side and an "away" side, each 3 players
// picked from the league's player pool for this match only. homeLabel/
// awayLabel mirror the paper sheet's blank "(Home) Team Name" / "Team Name"
// fields -- free text, not linked to any persistent team.
model Match {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId   String
  homeLabel  String?
  awayLabel  String?
  rounds     Round[]
}

model Round {
  id          String    @id @default(cuid())
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  roundNumber Int
  pairings    Pairing[]
}

// One home player vs. one away player within a round, playing two games (racks).
model Pairing {
  id           String @id @default(cuid())
  round        Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId      String
  homePlayer   Player @relation("HomePlayer", fields: [homePlayerId], references: [id])
  homePlayerId String
  awayPlayer   Player @relation("AwayPlayer", fields: [awayPlayerId], references: [id])
  awayPlayerId String
  homeGame1    Float  @default(0)
  homeGame2    Float  @default(0)
  awayGame1    Float  @default(0)
  awayGame2    Float  @default(0)
}
