// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Venue {
  id      String  @id @default(cuid())
  name    String
  address String?
  teams   Team[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  venue       Venue?   @relation(fields: [venueId], references: [id])
  venueId     String?
  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
}

model Player {
  id     String @id @default(cuid())
  name   String
  rating Float
  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  homePairings Pairing[] @relation("HomePlayer")
  awayPairings Pairing[] @relation("AwayPlayer")
}

model Match {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId String
  rounds     Round[]
}

model Round {
  id          String    @id @default(cuid())
  match       Match     @relation(fields: [matchId], references: [id])
  matchId     String
  roundNumber Int
  pairings    Pairing[]
}

// One home player vs. one away player within a round, playing two games (racks).
model Pairing {
  id           String @id @default(cuid())
  round        Round  @relation(fields: [roundId], references: [id])
  roundId      String
  homePlayer   Player @relation("HomePlayer", fields: [homePlayerId], references: [id])
  homePlayerId String
  awayPlayer   Player @relation("AwayPlayer", fields: [awayPlayerId], references: [id])
  awayPlayerId String
  homeGame1    Float  @default(0)
  homeGame2    Float  @default(0)
  awayGame1    Float  @default(0)
  awayGame2    Float  @default(0)
}
